# Copier ce fichier vers .env puis renseigner les valeurs
# Firebase > Paramètres du projet > Vos applications
# Usage : flutter run --dart-define-from-file=.env
# Les clés sont injectées au build (String.fromEnvironment), jamais embarquées dans le dépôt.
AndroidApiKey=
IosApiKey=

# Passer à true pour brancher l'application sur les émulateurs Firebase
# locaux (voir tool/seed_firestore.mjs). Laisser vide/absent en production.
USE_FIREBASE_EMULATORS=false
